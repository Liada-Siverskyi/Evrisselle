+#include <QHash>
+#include <netwm_def.h>
+
+/*
+ * Relay class for KWindowSystem events that batches updates
+ */
+class XWindowSystemEventBatcher : public QObject
+{
+    Q_OBJECT
+public:
+    XWindowSystemEventBatcher(QObject *parent);
+Q_SIGNALS:
+    void windowAdded(WId window);
+    void windowRemoved(WId window);
