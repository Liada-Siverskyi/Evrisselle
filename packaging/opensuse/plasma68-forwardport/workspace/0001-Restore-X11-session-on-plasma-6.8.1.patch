+    // It is not called after shutdown/restart
+    waitForKonqi();
+
+    out << "startkde: Shutting down...\n";
+
+    stopSystemdSession();
+    cleanupPlasmaEnvironment(oldSystemdEnvironment);
+
+    out << "startkde: Done.\n";
+
+    return 0;
+}
