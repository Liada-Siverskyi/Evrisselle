+quint32 VirtualDesktopInfo::XWindowPrivate::position(const QVariant &desktop) const
+{
+    bool ok = false;
+
+    const quint32 desktopNumber = desktop.toUInt(&ok);
+
+    if (!ok) {
+        return -1;
+    }
+
+    return desktopNumber;
