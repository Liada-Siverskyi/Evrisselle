+    }
+
+    const QModelIndex &sourceIndex = mapIfaceToSource(index);
+    const auto *m = dynamic_cast<const AbstractTasksModelIface *>(sourceIndex.model());
+
+    if (m) {
+        const_cast<AbstractTasksModelIface *>(m)->requestToggleShaded(sourceIndex);
+    }
